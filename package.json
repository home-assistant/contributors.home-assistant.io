{
  "name": "contributors.home-assistant.io",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm redirects && astro dev",
    "build": "pnpm redirects && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:demos": "node scripts/check-demos.ts",
    "check:component-docs": "node scripts/check-component-docs.ts",
    "links": "node scripts/check-links.ts",
    "structure": "node scripts/check-structure.ts",
    "clean": "node -e \"for (const dir of ['dist', '.astro', 'node_modules/.astro']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "tokens": "node scripts/sync-tokens.ts",
    "theme-variables": "node scripts/generate-theme-variables.ts",
    "redirects": "node scripts/generate-redirects.ts",
    "fragments": "node scripts/generate-fragments.ts",
    "bashio": "node scripts/generate-bashio.ts",
    "symbols": "node scripts/generate-symbols.ts",
    "source-paths": "node scripts/generate-source-paths.ts",
    "components": "node scripts/build-components.ts",
    "avatars": "node scripts/fetch-author-avatars.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "ical.js": "^2.2.1",
    "mermaid": "^12.1.0",
    "satori": "^0.63.0",
    "satteri": "^0.10.5",
    "satteri-callouts": "^1.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.5.2",
    "simple-icons": "^16.34.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
