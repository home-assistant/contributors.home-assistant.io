# Build output
dist/
.astro/

# Dependencies
node_modules/
# Where pnpm keeps its store when the home folder is on another
# filesystem, like in a dev container
.pnpm-store/

# VS Code writes this when it builds the dev container. Renovate does not
# update it, so the container features follow their major version instead.
.devcontainer/devcontainer-lock.json

# Python bytecode, from running scripts/symbols/extract.py
__pycache__/
*.pyc

# Logs
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.*

# Editors and OS
.DS_Store
.idea/

# Generated by `pnpm redirects` from redirects/, on every build
public/_redirects
public/redirect-fragments.json

# Temporary folders of `pnpm components`, removed when it finishes
.components-build-*
.components-previous-*
