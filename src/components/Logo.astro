---
// The Home Assistant Contributors logo. It comes in two layouts, each as one
// SVG for light and one for dark backgrounds, in public/images/:
//
// - Inline: the wordmark with "Contributors" next to it.
// - Stacked: "Contributors" under the wordmark.
//
// The logo scales with the font size of its parent: the house is about
// 1.4em tall in both layouts.
interface Props {
  // "auto" follows the color scheme, "white" is for dark or blue backgrounds.
  variant?: "auto" | "white";
  // "responsive" is inline, and stacked on narrow screens where the inline
  // logo does not fit.
  layout?: "inline" | "stacked" | "responsive";
}

const { variant = "auto", layout = "inline" } = Astro.props;

const SIZES = {
  inline: { width: 2924, height: 240 },
  stacked: { width: 1768, height: 438 },
};

// Keep in sync with the media query in the styles below.
const NARROW = "(max-width: 440px)";

const tones = variant === "white" ? ["dark"] : ["light", "dark"];
const src = (shape: "inline" | "stacked", tone: string) => `/images/contributors-logo-${shape}-on-${tone}.svg`;
const alt = "Home Assistant Contributors";
---

<span class:list={["lockup", `lockup--${layout}`]}>
  {
    tones.map((tone) => {
      const toneClass = variant === "white" ? undefined : `on-${tone}`;

      if (layout === "responsive") {
        // A picture, so the browser only downloads the layout it shows.
        return (
          <picture class:list={["logo", toneClass]}>
            <source media={NARROW} srcset={src("stacked", tone)} {...SIZES.stacked} />
            <img src={src("inline", tone)} alt={alt} {...SIZES.inline} />
          </picture>
        );
      }

      return (
        <span class:list={["logo", toneClass]}>
          <img src={src(layout, tone)} alt={alt} {...SIZES[layout]} />
        </span>
      );
    })
  }
</span>

<style>
  .lockup {
    display: inline-flex;
    line-height: 1;
  }

  .logo {
    display: block;
  }

  /*
   * The house is 234 of 240 units tall in the inline SVG, and 234 of 438 in
   * the stacked one, so these heights draw it at the same size.
   */
  img {
    display: block;
    width: auto;
    height: 1.4em;
  }

  .lockup--stacked img {
    height: 2.555em;
  }

  /* Same width as NARROW in the frontmatter. */
  @media (max-width: 440px) {
    .lockup--responsive img {
      height: 2.555em;
    }
  }

  .on-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .on-light {
      display: none;
    }

    :root:not([data-theme="light"]) .on-dark {
      display: block;
    }
  }

  :root[data-theme="dark"] .on-light {
    display: none;
  }

  :root[data-theme="dark"] .on-dark {
    display: block;
  }
</style>
