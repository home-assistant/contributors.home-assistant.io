---
// The Home Assistant wordmark with "Contributors" as the program name, set
// apart by a thin rule.
interface Props {
  // "auto" follows the color scheme, "white" is for dark or blue backgrounds.
  variant?: "auto" | "white";
}

const { variant = "auto" } = Astro.props;
---

<span class:list={["lockup", `lockup--${variant}`]}>
  {
    variant === "white" ? (
      <img class="wordmark" src="/images/home-assistant-logo-white.svg" alt="Home Assistant" width="1705" height="241" />
    ) : (
      <>
        <img class="wordmark on-light" src="/images/home-assistant-logo.svg" alt="Home Assistant" width="1705" height="241" />
        <img class="wordmark on-dark" src="/images/home-assistant-logo-white.svg" alt="Home Assistant" width="1705" height="241" />
      </>
    )
  }
  <span class="program">Contributors</span>
</span>

<style>
  /*
   * The inline lockup is laid out as text on purpose. An inline image sits
   * with the bottom of its margin box on the text baseline, so a negative
   * bottom margin equal to the space under the wordmark's letters puts those
   * letters exactly on the baseline of "Contributors", at any size.
   *
   * The letters end at 80.9% of the image height (measured from the SVG),
   * so 19.1% of 1.4em, about 0.267em, sits below the baseline.
   */
  .lockup {
    display: inline-block;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark {
    display: inline;
    height: 1.4em;
    width: auto;
    margin: 0 0.6em -0.267em 0;
    vertical-align: baseline;
  }

  .program {
    padding-left: 0.6em;
    border-left: 1.5px solid currentColor;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .on-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .on-light {
      display: none;
    }

    :root:not([data-theme="light"]) .on-dark {
      display: inline;
    }
  }

  :root[data-theme="dark"] .on-light {
    display: none;
  }

  :root[data-theme="dark"] .on-dark {
    display: inline;
  }
</style>
