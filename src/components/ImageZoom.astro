---
// Lets readers zoom into the images of a page or post: select one to see it
// as large as the window allows, and select it again or press Escape to go
// back. Where the browser can, the image grows from its place in the page.
// Images that link somewhere keep their link instead.
import Icon from "./Icon.astro";
---

<dialog class="image-zoom" aria-label="Zoomed image">
  {/* Selecting anywhere in the dialog closes it, this button included. */}
  <button type="button" class="image-zoom-close" aria-label="Close image">
    <Icon name="x" size={20} />
  </button>
  <img alt="" />
</dialog>

<script>
  const NAME = "image-zoom";

  const dialog = document.querySelector<HTMLDialogElement>("dialog.image-zoom");
  const zoomed = dialog?.querySelector("img");
  const images = document.querySelectorAll<HTMLImageElement>(".prose img:not(a img)");

  // The image in the page the dialog shows, to animate back to.
  let source: HTMLImageElement | undefined;

  // Animated with a view transition, which moves an element with a name from
  // where it was to where it ends up. Without support for them, or when the
  // reader prefers less motion, the change just happens.
  function transition(change: () => void): Promise<void> {
    if (!("startViewTransition" in document) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      change();
      return Promise.resolve();
    }

    return document.startViewTransition(change).finished;
  }

  function open(image: HTMLImageElement) {
    if (!dialog || !zoomed) {
      return;
    }

    source = image;
    image.style.viewTransitionName = NAME;
    transition(() => {
      image.style.viewTransitionName = "";
      zoomed.src = image.currentSrc || image.src;
      zoomed.alt = image.alt;
      zoomed.style.viewTransitionName = NAME;
      dialog.showModal();
    });
  }

  async function close() {
    if (!dialog?.open || !zoomed) {
      return;
    }

    const image = source;
    await transition(() => {
      zoomed.style.viewTransitionName = "";
      if (image) {
        image.style.viewTransitionName = NAME;
      }

      dialog.close();
    });

    // Only one element can carry the name at a time.
    if (image) {
      image.style.viewTransitionName = "";
    }
  }

  for (const image of images) {
    // A button to open the zoom, also for keyboards and screen readers.
    image.tabIndex = 0;
    image.setAttribute("role", "button");
    image.setAttribute("aria-haspopup", "dialog");
    image.setAttribute("aria-label", image.alt ? `Zoom into image: ${image.alt}` : "Zoom into image");
    image.classList.add("image-zoom-source");
    image.addEventListener("click", () => open(image));
    image.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        open(image);
      }
    });
  }

  dialog?.addEventListener("click", close);
  // Escape closes the dialog at once; go through close() to animate it.
  dialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
    close();
  });
</script>

<style is:global>
  .image-zoom-source {
    cursor: zoom-in;
  }

  .image-zoom {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }

  .image-zoom[open] {
    display: grid;
    place-items: center;
  }

  /* On top of the image, so it does not move or shrink it. */
  .image-zoom-close {
    position: fixed;
    top: var(--ha-space-4);
    inset-inline-end: var(--ha-space-4);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--ha-border-radius-md);
    background: var(--site-surface);
    color: var(--site-text);
    cursor: pointer;
  }

  .image-zoom-close:hover {
    background: var(--site-surface-hover);
  }

  .image-zoom::backdrop {
    background: var(--site-bg);
  }

  .image-zoom img {
    max-width: calc(100vw - 48px);
    max-height: calc(100dvh - 48px);
    object-fit: contain;
  }
</style>
