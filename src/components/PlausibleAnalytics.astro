---
// Privacy-first, self-hosted analytics. The collected data is public, see
// PLAUSIBLE.dashboard.
//
// The shared loader of the Open Home Foundation loads the Plausible script
// of this site, and replaces every referrer that is not on the shared allow
// list, so the private URL of a visitor's own Home Assistant is never
// recorded. See the "Analytics (Plausible)" section of
// https://github.com/OpenHomeFoundation/openhomefoundation.org.
//
// The loader is async. The queue below lets pages send events right away,
// like the 404 page and PageFeedback.astro. The loader keeps it, and
// Plausible sends what is queued once it loaded.
import { PLAUSIBLE } from "../data/site";

const src = `${PLAUSIBLE.loader}?site=${encodeURIComponent(PLAUSIBLE.site)}`;
---

{
  PLAUSIBLE.site && (
    <>
      <script is:inline>
        window.plausible =
          window.plausible ||
          function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
          };
      </script>
      <script is:inline async src={src} />
    </>
  )
}
