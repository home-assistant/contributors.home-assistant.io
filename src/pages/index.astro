---
import heroBackground from "../assets/hero-background.webp";
import tree from "../assets/shapes/hero-tree.svg?raw";
import EventList from "../components/EventList.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { AREA_GROUPS, groupLinks, type AreaGroup } from "../data/areas";
import { SITE } from "../data/site";
import Base from "../layouts/Base.astro";
import { getPosts } from "../lib/blog";
import { CALENDAR, getUpcomingEvents } from "../lib/events";
import { ogImagePath } from "../lib/og";

// The group marks: the same little tree for every group, with the branch of
// that group highlighted, from "Contributors homepage hero" in Figma (nodes
// 23:1442 and 23:1454). Each branch is a dot and its stem.
const TREE = {
  trunk: [
    "M107.519 71.238C127.191 71.238 143.138 55.291 143.138 35.619C143.138 15.947 127.191 0 107.519 0C87.848 0 71.9 15.947 71.9 35.619C71.9 55.291 87.848 71.238 107.519 71.238Z",
    "M119.389 35.614H95.645V294.708H119.389V35.614Z",
  ],
  upper: [
    "M35.619 135.248C55.291 135.248 71.238 119.301 71.238 99.629C71.238 79.957 55.291 64.01 35.619 64.01C15.947 64.01 0 79.957 0 99.629C0 119.301 15.947 135.248 35.619 135.248Z",
    "M95.645 294.476L119.389 294.432L119.345 194.587C119.316 178.577 110.583 157.799 99.03 146.251L30.344 77.565L13.555 94.354L82.241 163.04C89.215 170.015 95.581 185.07 95.601 194.631L95.645 294.476Z",
  ],
  lower: [
    "M35.619 225.706C55.291 225.706 71.238 209.758 71.238 190.087C71.238 170.415 55.291 154.468 35.619 154.468C15.947 154.468 0 170.415 0 190.087C0 209.758 15.947 225.706 35.619 225.706Z",
    "M95.645 294.904L119.389 294.86L119.345 285.044C119.316 269.035 110.583 248.257 99.03 236.708L30.344 168.022L13.555 184.812L82.241 253.497C89.215 260.472 95.581 275.527 95.601 285.088L95.645 294.904Z",
  ],
  right: [
    "M179.415 170.867C199.087 170.867 215.034 154.92 215.034 135.248C215.034 115.576 199.087 99.629 179.415 99.629C159.743 99.629 143.796 115.576 143.796 135.248C143.796 154.92 159.743 170.867 179.415 170.867Z",
    "M119.389 294.556L95.645 294.513L95.689 230.211C95.718 214.201 104.451 193.423 116.004 181.875L184.69 113.189L201.479 129.978L132.794 198.664C125.819 205.639 119.453 220.694 119.433 230.255L119.389 294.556Z",
  ],
};
type Branch = keyof typeof TREE;
const BRANCHES = Object.keys(TREE) as Branch[];

// Start is the trunk everything grows from. Understand shows the whole tree.
const HIGHLIGHT: Record<AreaGroup, Branch[]> = {
  start: ["trunk"],
  build: ["lower"],
  shape: ["right"],
  run: ["upper"],
  understand: BRANCHES,
};

const sections = (Object.entries(AREA_GROUPS) as [AreaGroup, string][]).map(
  ([groupId, label]) => ({
    id: groupId,
    label,
    areas: groupLinks(groupId),
    lit: HIGHLIGHT[groupId],
  }),
);

const latestPosts = (await getPosts()).slice(0, 3);

// Hidden when nothing is planned. When the calendar couldn't be loaded, the
// block stays, with the links to subscribe to it.
const calendar = await getUpcomingEvents();
const showEvents = !calendar.loaded || calendar.events.length > 0;
---

<Base title={SITE.title} description={SITE.description} image={ogImagePath("index")}>
  <main id="main-content" tabindex="-1">
    <section class="hero" style={`--hero-image: url("${heroBackground.src}")`}>
      <div class="container hero-inner">
        <div class="hero-text">
          <h1>
            <span class="line">Help build</span>
            <span class="line">the open home</span>
          </h1>

          <p class="intro">
            Code, design, documentation, translations, or community.
            Whatever you bring, this is where you start.
          </p>

          <div class="actions">
            <a class="button button-mint" href="/start/first-contribution/">
              <span class="button-icon"><Icon name="chevron-right" size={18} /></span>
              Make your first contribution
            </a>
            <a class="button button-quiet" href="#areas">Browse all areas</a>
          </div>
        </div>
        <span class="tree" aria-hidden="true" set:html={tree} />
      </div>
    </section>

    <section id="areas" class="container index">
      <h2>What do you want to do?</h2>
      <div class="groups">
        {
          sections.map((section) => (
            <div class:list={["group", `group--${section.id}`]}>
              <h3>
                <svg class="mark" viewBox="0 0 215.034 294.904" aria-hidden="true">
                  <g class="mark-rest">
                    {BRANCHES.filter((b) => !section.lit.includes(b)).flatMap((b) => TREE[b]).map((d) => <path d={d} />)}
                  </g>
                  {section.lit.flatMap((b) => TREE[b]).map((d) => <path d={d} />)}
                </svg>
                {section.label}
              </h3>
              <ul>
                {section.areas.map((area) => (
                  <li>
                    <a href={area.href}>
                      <span class="area-icon"><Icon name={area.icon} size={24} /></span>
                      <span class="area-title">{area.action}</span>
                      <span class="area-text">{area.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="container steps-section">
      <div class="steps-panel">
        <h2>New here? Four steps.</h2>
        <ol class="steps">
          <li>
            <a class="step-link" href="#areas">
              <span class="step-title">Pick an area</span>
              <span class="step-text">Most areas have a first contribution guide of their own.</span>
            </a>
          </li>
          <li>
            <a class="step-link" href="/start/where-we-talk/">
              <span class="step-title">Join the conversation</span>
              <span class="step-text">Find the people working on it, and say hi.</span>
            </a>
          </li>
          <li>
            <a class="step-link" href="/start/first-contribution/">
              <span class="step-title">Find something small</span>
              <span class="step-text">A good first issue, a typo, a missing translation.</span>
            </a>
          </li>
          <li>
            <a class="step-link" href="/start/pull-requests/">
              <span class="step-title">Ship it</span>
              <span class="step-text">Get feedback, iterate, and see it land in a release.</span>
            </a>
          </li>
        </ol>
      </div>
    </section>

    {
      latestPosts.length > 0 && (
        <section class="container blog">
          <div class="blog-header">
            <h2>From the blog</h2>
            <a href="/blog/">All posts</a>
          </div>
          <ul class="posts">
            {latestPosts.map((post) => (
              <li>
                <PostCard post={post} headingLevel={3} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      showEvents && (
        <section class="container coming-up">
          <div class="blog-header">
            <h2>Coming up</h2>
            <a href="/community/reference/events/">All events and how to join</a>
          </div>
          <p class="events-intro">
            Release days, meetups, and community syncs: video calls about one project, open to everyone who is
            interested. Select an event to see what it is about and how to join.
          </p>
          <div class="events-card">
            <EventList limit={3} />
            {!calendar.loaded && (
              <p class="subscribe">
                <a href={CALENDAR.google}>Add to Google Calendar</a>
                <a href={CALENDAR.ics}>Calendar feed for other apps</a>
              </p>
            )}
          </div>
        </section>
      )
    }
  </main>
</Base>

<style>
  .container {
    max-width: var(--site-page-width);
    margin: 0 auto;
    padding: 0 var(--site-gutter);
  }

  /*
   * Hero, from "Contributors homepage hero" in Figma (node 22:995): a cyan
   * glow that fades to light blue at the edges, navy text, and the branches
   * of the Home Assistant tree on the right, running off the edges. At
   * night, the same in deep teal.
   *
   * The glow in Figma is a shader, which CSS cannot draw. The background is
   * that shader, exported from the Figma app, so it stays exactly as
   * designed. Export it from the app: Figma's API draws this shader
   * differently. It covers the hero at any width, centered.
   */
  .hero {
    --hero-bg: var(--hero-image) center / cover no-repeat, #2fe1d6;
    --hero-tree-opacity: 1;

    overflow: hidden;
    padding: clamp(48px, 7vw, 96px) 0;
    background: var(--hero-bg);
    color: var(--site-text);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hero {
      --hero-bg: linear-gradient(105deg, #03161c 0%, #072f3d 42%, #0a4750 74%, #0b5a70 100%);
      --hero-tree-opacity: 0.4;
    }
  }

  :root[data-theme="dark"] .hero {
    --hero-bg: linear-gradient(105deg, #03161c 0%, #072f3d 42%, #0a4750 74%, #0b5a70 100%);
    --hero-tree-opacity: 0.4;
  }

  .hero-inner {
    position: relative;
  }

  /* Above the tree, which reaches under the end of the headline. */
  .hero-text {
    position: relative;
    z-index: 1;
  }

  /*
   * Where Figma has it: 696px from the start of the text, and 75px above
   * it, blended in hard light. The hero cuts off what runs past its edges.
   * On a phone, it starts past the edge of the screen.
   */
  .tree {
    position: absolute;
    top: -75px;
    left: calc(var(--site-gutter) + 696px);
    width: 610px;
    opacity: var(--hero-tree-opacity);
    mix-blend-mode: hard-light;
  }

  .tree :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .intro {
    max-width: 620px;
    margin: var(--ha-space-6) 0 0;
    color: var(--site-text);
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.35;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ha-space-3);
    margin-top: var(--ha-space-8);
  }

  /* Mint, with the icon in a white circle, like "Find a meetup near you". */
  .button-mint {
    padding-left: var(--ha-space-2);
    background: var(--brand-mint);
    color: var(--brand-navy);
  }

  .button-mint:hover {
    color: var(--brand-navy);
    box-shadow: 0 4px 16px rgb(0 35 50 / 0.2);
  }

  .button-icon {
    display: flex;
    padding: var(--ha-space-2);
    border-radius: 50%;
    background: #ffffff;
  }

  .button-quiet {
    background: var(--site-surface);
    color: var(--site-text);
  }

  .button-quiet:hover {
    color: var(--site-text);
    background: var(--site-surface-hover);
  }

  /* The area index: type and rules, no boxes. */

  .index {
    padding-top: var(--ha-space-16);
  }

  h2 {
    margin: 0;
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr));
    gap: var(--ha-space-16) var(--ha-space-16);
    margin-top: var(--ha-space-12);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--ha-space-3);
    margin: 0 0 var(--ha-space-2);
    font-size: 18px;
    font-weight: 650;
    color: var(--site-text-muted);
  }

  /*
   * Each group is marked with the same little tree, with its own branch
   * highlighted in the tile color of the group, like the area icons.
   */
  .group {
    --tile: var(--site-tile-everyone);
    --tile-bg: var(--site-tile-everyone-bg);
  }

  .group--build {
    --tile: var(--site-tile-build);
    --tile-bg: var(--site-tile-build-bg);
  }

  .group--shape {
    --tile: var(--site-tile-shape);
    --tile-bg: var(--site-tile-shape-bg);
  }

  .group--run {
    --tile: var(--site-tile-run);
    --tile-bg: var(--site-tile-run-bg);
  }

  /* The highlighted branch in the group's color, the rest of the tree quiet. */
  .mark {
    flex: 0 0 auto;
    width: auto;
    height: 24px;
    fill: var(--tile);
  }

  .group--understand .mark {
    fill: var(--site-text-muted);
  }

  .mark-rest {
    fill: var(--site-text);
    opacity: 0.4;
  }

  /*
   * "Start here" holds one area, the way in for everyone. It spans the full
   * width, with the text next to the title instead of under it, so it reads
   * as the front door and not as a group that lost its other tiles. The
   * link rule is doubled up to win over `.group a`, which comes later.
   */
  .group--start {
    grid-column: 1 / -1;
  }

  .group--start .area-title {
    font-size: clamp(26px, 3vw, 36px);
  }

  @media (min-width: 900px) {
    .group.group--start a {
      display: flex;
      align-items: center;
      column-gap: var(--ha-space-4);
    }

    .group--start .area-text {
      max-width: 60ch;
      margin-left: var(--ha-space-4);
      padding-left: var(--ha-space-6);
      border-left: 1px solid var(--site-border);
      font-size: 18px;
    }
  }

  .group ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--site-border);
  }

  .group li {
    border-top: 1px solid var(--site-border);
  }

  /* Icon in its own column, next to the title; the text lines up under it. */
  .group a {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    column-gap: var(--ha-space-4);
    row-gap: var(--ha-space-1);
    padding: var(--ha-space-5) 0;
    color: var(--site-text);
    text-decoration: none;
  }

  .area-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--tile-bg);
    color: var(--tile);
  }

  .area-text {
    grid-column: 2;
  }

  .area-title {
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .area-text {
    color: var(--site-text-muted);
    line-height: 1.5;
  }

  .group a:hover .area-icon {
    background: var(--tile);
    color: var(--tile-bg);
  }

  .group a:hover .area-title {
    color: var(--site-link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .steps,
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Steps, a real sequence, in a rounded navy panel with mint numbers, in
   * the colors of the navy band the homepage had before.
   */
  .steps-section {
    margin-top: var(--ha-space-20);
  }

  .steps-panel {
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--site-radius-card);
    background: var(--brand-navy);
    color: #ffffff;
  }

  .steps {
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--ha-space-8);
    margin-top: var(--ha-space-10);
  }

  .steps li {
    counter-increment: step;
    display: flex;
    flex-direction: column;
    gap: var(--ha-space-2);
    padding-top: var(--ha-space-4);
    border-top: 2px solid rgb(255 255 255 / 0.12);
  }

  .steps li::before {
    content: counter(step);
    font-size: 56px;
    font-weight: 600;
    line-height: 1;
    color: var(--brand-mint);
  }

  /* The whole step is the link, so it is an easy target on a phone. */
  .step-link {
    display: flex;
    flex-direction: column;
    gap: var(--ha-space-2);
    color: inherit;
    text-decoration: none;
  }

  /* Underlined, so the steps read as links and not as decoration. */
  .step-link .step-title {
    text-decoration: underline;
    text-decoration-color: rgb(22 243 190 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .step-link:hover .step-title,
  .step-link:focus-visible .step-title {
    text-decoration-color: var(--brand-mint);
  }

  .step-title {
    margin-top: var(--ha-space-3);
    font-size: 20px;
    font-weight: 650;
  }

  .step-text {
    color: #b1c3cf;
    line-height: 1.5;
  }

  /* Blog */

  .blog {
    padding-top: var(--ha-space-20);
  }

  .blog-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ha-space-3);
  }

  .blog-header a {
    font-weight: 600;
  }

  /* Coming up: the next events of the contributor calendar. */

  .coming-up {
    padding-top: var(--ha-space-16);
  }

  .events-intro {
    max-width: 70ch;
    margin: var(--ha-space-3) 0 0;
    color: var(--site-text-muted);
  }

  .events-card {
    margin-top: var(--ha-space-8);
    padding: var(--ha-space-5) var(--ha-space-6);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-card);
    background: var(--site-surface);
  }

  /* Side by side, in the same columns as the posts above. */
  .events-card :global(.events) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--ha-space-4) var(--ha-space-6);
  }

  .events-card :global(.event) {
    padding: 0;
    border-top: 0;
  }

  .subscribe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ha-space-2) var(--ha-space-6);
    margin: var(--ha-space-3) 0 0;
    font-weight: 600;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--ha-space-4);
    margin-top: var(--ha-space-8);
  }
</style>
