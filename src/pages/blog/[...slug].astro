---
import { render } from "astro:content";
import { getBlogTopic } from "../../data/blog-topics";
import PostByline from "../../components/PostByline.astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import {
  type BlogPost,
  getPosts,
  postHref,
  postPath,
  relatedPosts,
  titleParts,
} from "../../lib/blog";
import { ogImagePath, postCardSlug } from "../../lib/og";

export async function getStaticPaths() {
  const posts = await getPosts();

  // Posts are newest first: the next one in the list is the older post.
  return posts.map((post, index) => ({
    params: { slug: postPath(post) },
    props: {
      post,
      newer: posts[index - 1],
      older: posts[index + 1],
      related: relatedPosts(post, posts),
    },
  }));
}

interface Props {
  post: BlogPost;
  newer?: BlogPost;
  older?: BlogPost;
  related: BlogPost[];
}

const { post, newer, older, related } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath(postCardSlug(post))}
  article={{ published: post.data.date, authors: post.data.authors }}
  markdown={`${postHref(post)}index.md`}
  llms="/blog/llms.txt"
>
  <main class="page" id="main-content" tabindex="-1">
    <article data-pagefind-body>
      <meta data-pagefind-filter="area[content]" content="blog" />
      <meta data-pagefind-meta="trail[content]" content="Blog" />
      <header>
        <p class="back"><a href="/blog/">Blog</a></p>
        <h1 data-pagefind-meta="title">
          {titleParts(post.data.title).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
        </h1>
        <p class="meta">
          <PostByline post={post} size="large" />
        </p>
        <p class="tags">
          {
            post.data.areas.map((id) => (
              <a class="tag" href={getBlogTopic(id)?.href}>{getBlogTopic(id)?.title}</a>
            ))
          }
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>

    <nav class="neighbours" aria-label="More posts">
      {
        older && (
          <a class="neighbour" href={postHref(older)} rel="prev">
            <span class="direction">Older post</span>
            <span class="neighbour-title">
              {titleParts(older.data.title).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
            </span>
          </a>
        )
      }
      {
        newer && (
          <a class="neighbour neighbour--newer" href={postHref(newer)} rel="next">
            <span class="direction">Newer post</span>
            <span class="neighbour-title">
              {titleParts(newer.data.title).map((part) => (part.code ? <code>{part.text}</code> : part.text))}
            </span>
          </a>
        )
      }
    </nav>

    {
      related.length > 0 && (
        <section class="related" data-pagefind-ignore>
          <h2>Related posts</h2>
          <ul>
            {related.map((item) => (
              <li>
                <PostCard post={item} headingLevel={3} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

<style>
  .page {
    max-width: calc(var(--site-content-width) + 2 * 72px + 2 * var(--site-gutter));
    margin: 0 auto;
    padding: var(--ha-space-8) var(--site-gutter) 0;
  }

  .neighbours {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--ha-space-4);
    margin: var(--ha-space-6) 0 0;
  }

  .neighbour {
    display: flex;
    flex-direction: column;
    gap: var(--ha-space-1);
    padding: var(--ha-space-5) var(--ha-space-6);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-tile);
    background: var(--site-surface);
    color: var(--site-text);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .neighbour:hover {
    border-color: var(--site-link);
    color: var(--site-text);
  }

  /* The newer post sits on the right, also when it is the only one. */
  .neighbour--newer {
    grid-column: -2;
    text-align: right;
  }

  .direction {
    font-size: 14px;
    color: var(--site-text-muted);
  }

  .neighbour-title {
    font-weight: 650;
    line-height: 1.3;
  }

  .related {
    margin: var(--ha-space-16) 0 0;
  }

  .related h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--ha-space-4);
    margin: var(--ha-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  article {
    padding: clamp(24px, 5vw, 64px) clamp(20px, 5vw, 72px);
    border-radius: var(--site-radius-card);
    border: 1px solid var(--site-border);
    background: var(--site-surface);
  }

  .back {
    margin: 0;
    font-weight: 600;
  }

  h1 {
    margin: var(--ha-space-3) 0 0;
    font-size: clamp(36px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  h1 code {
    font-size: 0.8em;
  }

  .meta {
    margin: var(--ha-space-6) 0 var(--ha-space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ha-space-2);
    margin: 0 0 var(--ha-space-8);
  }

  /*
   * One post from the old developer site embeds the live demo, with a note
   * for small screens instead. These are the styles it had there.
   */
  .prose :global(#demo) {
    width: 100%;
    height: 475px;
    border: 2px solid #03a9f4;
    border-radius: 4px;
  }

  .prose :global(.show-small) {
    display: none;
  }

  @media (max-width: 600px) {
    .prose :global(.hide-small) {
      display: none;
    }

    .prose :global(.show-small) {
      display: initial;
    }
  }

  .tag {
    padding: 2px var(--ha-space-2);
    border-radius: var(--ha-border-radius-pill);
    background: var(--site-accent-quiet);
    color: var(--site-on-accent-quiet);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
  }
</style>
